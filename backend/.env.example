NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:5173
# For a cross-site production frontend/API pair, use COOKIE_SAME_SITE=none over HTTPS.
COOKIE_SAME_SITE=lax
MONGO_URI=mongodb://127.0.0.1:27018/mingle_dev
# Replace with a unique random value of at least 32 characters before starting the app.
JWT_SECRET=replace-me
EMAIL_VERIFICATION_REQUIRED=false

# Optional until the related feature is configured.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=mingle
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
ARCJET_KEY=
ARCJET_ENV=development
